# Optional colon-separated absolute repository paths that should receive
# a symlinked AGENTS.md from this repo when you run `pnpm run symlink:opencode`.
# Add or remove paths here, then rerun the symlink script.
AGENTS_SYMLINK_PATHS=/Users/your-user/IdeaProjects/repo-one:/Users/your-user/IdeaProjects/repo-two

# Optional colon-separated absolute workspace roots to reconcile.
# When set, the symlink script removes AGENTS.md symlinks from sibling repos
# under these roots unless the repo is listed in AGENTS_SYMLINK_PATHS.
AGENTS_SYMLINK_SCAN_ROOTS=/Users/your-user/IdeaProjects
