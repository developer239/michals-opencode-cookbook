{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./dist/index.js"],
  "default_agent": "orchestrator",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "orchestrator": {
      "model": "openai/gpt-5.5",
      "description": "Primary orchestrator agent.",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "doom_loop": "allow",
        "external_directory": "allow",
        "task": "allow",
        "question": "allow",
        "skill": "allow",
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "codebase_*": "allow",
        "oc_*": "allow"
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask"
    }
  }
}
